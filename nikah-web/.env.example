# Public site origin — used in metadata, OG tags, and every guest link.
NEXT_PUBLIC_SITE_URL=https://nikah.example

# Supabase — guest list, RSVP, and wishes storage.
# URL: Supabase Dashboard → Project Settings → Data API.
# Secret key (sb_secret_…): Project Settings → API Keys. Server-only, bypasses
# RLS, and must never carry a NEXT_PUBLIC_ prefix. The publishable key is not
# used anywhere: the browser never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Shared passphrase for /dashboard — the only thing in front of the guest list.
DASHBOARD_PASSPHRASE=

# fal.ai key — consumed only by scripts/generate-assets.mjs, never bundled to the site.
FAL_KEY=
