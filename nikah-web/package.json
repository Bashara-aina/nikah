{
  "name": "nikah-web",
  "version": "0.1.0",
  "private": true,
  "description": "Wedding invitation for Bashara & Hanifah — Next.js App Router, Motion, GSAP, Lenis, fal.ai video loops.",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "copy-assets": "node scripts/copy-assets.mjs",
    "remediate-assets": "node scripts/remediate-assets.mjs",
    "gen:list": "node --env-file=.env scripts/generate-assets.mjs --list",
    "gen:dry": "node --env-file=.env scripts/generate-assets.mjs --phase=0 --dry-run",
    "gen:0": "node --env-file=.env scripts/generate-assets.mjs --phase=0",
    "gen:0b": "node --env-file=.env scripts/generate-assets.mjs --phase=0b",
    "gen:1": "node --env-file=.env scripts/generate-assets.mjs --phase=1",
    "gen:2": "node --env-file=.env scripts/generate-assets.mjs --phase=2",
    "gen:4": "node --env-file=.env scripts/generate-assets.mjs --phase=4",
    "gen:6": "node --env-file=.env scripts/generate-assets.mjs --phase=6"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.23",
    "motion": "^12.0.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fal-ai/client": "^1.10.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
